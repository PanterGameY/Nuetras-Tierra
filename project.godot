; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NuestraTierra2.0"
run/main_scene="res://interfaz/pantallas/login/Login.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

InputVehiculo="*res://codigo/entidades/vehiculo/InputVehiculo.gd"
DatosUsuario="*res://Datos/usuario/DatosUsuario.gd"
SupabaseManager="*res://codigo/nucleo/sistema/SupabaseManager.gd"
MenuSystem="*res://interfaz/sistema/MenuSystem.gd"
Firebase="*uid://1tu2hgwphuxb"
SettingsManager="*res://codigo/nucleo/sistema/SettingsManager.gd"
FpScontador="*res://codigo/nucleo/sistema/FPScontador.gd"
Network="*res://codigo/nucleo/red/Network.gd"
PlayersManager="*res://codigo/nucleo/red/PlayersManager.gd"
GestorVehiculos="*res://codigo/entidades/vehiculo/GestorVehiculos.gd"
GestorAnuncios="*res://codigo/sistemas/anuncios/GestorAnuncios.gd"

[display]

window/size/viewport_width=2392
window/size/viewport_height=1080
window/size/mode=3
window/size/initial_position_type=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotFirebaseAndroid/plugin.cfg", "res://addons/admob/plugin.cfg")

[global_group]

Vehiculo=""

